NODE_ENV=production
PORT=8000

# Database
DB_HOST=localhost
DB_USER=smwaterjet
DB_PASSWORD=changeme
DB_NAME=smwaterjet

# Auth
JWT_SECRETKEY=changeme

# Turnstile
