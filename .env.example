NODE_ENV=production
PORT=8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=smwaterjet
DB_PASSWORD=changeme
DB_NAME=smwaterjet
DB_SSL=disable
DB_SSL_CA_PATH=

# Auth
JWT_SECRETKEY=changeme

# Turnstile
CAPTCHA_SECRETKEY=changeme

# CORS (comma-separated). Required in production.
CORS_ORIGINS=https://example.com,https://admin.example.com

# R2 Storage (optional)
STORAGE_DRIVER=local
R2_BUCKET=your-bucket
R2_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Rate limiting (milliseconds)
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=50
